{
  "name": "project-x-client",
  "productName": "Project X",
  "version": "0.0.1",
  "description": "Project X game client.",
  "type": "module",
  "main": ".vite/build/index.js",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "bootstrap:wasm": "wasm-pack build --out-dir '../wasm-pkg' --out-name 'project-x-wasm-pkg' --target bundler ../wasm_bridge",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "keywords": [],
  "author": {
    "name": "pierreyoda",
    "email": "pierreyoda@users.noreply.github.com"
  },
  "license": "MIT",
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "pixi-viewport": "6.0.3",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@eslint/js": "9.39.5",
    "@floating-ui/dom": "1.8.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@lucide/svelte": "1.54.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/svelte-vite": "10.6.5",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/electron-squirrel-startup": "1.0.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "electron": "45.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-storybook": "10.6.5",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "imports": {
    "#shared/*": "./src/shared/*",
    "#domains/*": "./src/domains/*/index.ts",
    "#shell/*": "./src/shell/*"
  }
}
